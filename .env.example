# Copia a .env y completa. Nunca subas .env al repositorio.
DATABASE_URL="postgresql://chasqui:chasqui_dev@localhost:5432/chasqui"

# Clave para firmar sesiones (mínimo 32 caracteres). Genera una con: openssl rand -base64 48
SESSION_SECRET="cambia-esto-por-un-valor-largo-y-aleatorio-32+"

# Usuario administrador inicial que crea el seed
ADMIN_EMAIL="admin@chasqui.local"
ADMIN_PASSWORD="CambiaEstaClave-2026"

# URL pública del sitio (para enlaces en WhatsApp/correo)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp: "console" (solo registra, para desarrollo) o "cloud" (WhatsApp Business Cloud API de Meta)
WHATSAPP_PROVIDER="console"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_TEMPLATE_LANG="es"

# Protege /api/cron/* (Vercel lo envía como Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
